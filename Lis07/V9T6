function textOffset(root,node,offset){let total=0;const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let cur;while(cur=w.nextNode()){if(cur===node)return total+offset;total+=cur.nodeValue.length}return total}
function nodeAtOffset(root,target){let total=0;const w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);let cur;while(cur=w.nextNode()){const len=cur.nodeValue.length;if(total+len>=target)return [cur,Math.max(0,target-total)];total+=len}return [null,0]}
function makeMark(range,id,note=''){const m=document.createElement('mark');m.className='study-hl'+(note?' has-note':'');m.dataset.hid=id;if(note){m.dataset.note=note;m.title=note}range.surroundContents(m);return m}
function applySavedAnnotations(){[...annData().items].sort((a,b)=>b.start-a.start).forEach(item=>{const root=document.getElementById(item.rootId);if(!root)return;const [sn,so]=nodeAtOffset(root,item.start),[en,eo]=nodeAtOffset(root,item.end);if(!sn||!en)return;try{const r=document.createRange();r.setStart(sn,so);r.setEnd(en,eo);makeMark(r,item.id,item.note||'')}catch(e){}})}
function selectedRoot(range){return [...document.querySelectorAll('.pane')].find(root=>root.contains(range.commonAncestorContainer))}
function selectionHasFormControls(range){const frag=range.cloneContents();return !!frag.querySelector?.('input,select,button,textarea,audio')}
function positionTools(rect){textTools.style.left=Math.max(8,Math.min(window.innerWidth-230,rect.left))+'px';textTools.style.top=Math.max(8,rect.top-44)+'px';textTools.classList.add('show')}
function hideTools(){textTools.classList.remove('show');activeMark=null}
function setToolLabelsForSelection(){hlTool.textContent='Highlight';noteTool.textContent='Take note';hlTool.classList.remove('danger');noteTool.classList.remove('danger')}
function setToolLabelsForMark(mark){hlTool.textContent='Xóa highlight';hlTool.classList.add('danger');if(mark.dataset.note){noteTool.textContent='Xóa take note';noteTool.classList.add('danger')}else{noteTool.textContent='Take note';noteTool.classList.remove('danger')}}
function captureSelection(){if(submitted)return;const s=window.getSelection();if(!s||!s.rangeCount||s.isCollapsed)return;const r=s.getRangeAt(0),root=selectedRoot(r);if(!root||!s.toString().trim()||selectionHasFormControls(r))return;savedRange=r.cloneRange();savedRoot=root;activeMark=null;setToolLabelsForSelection();positionTools(r.getBoundingClientRect())}
function addAnnotation(withNote=false){if(!savedRange||!savedRoot)return;let note='';if(withNote){note=prompt('Nhập ghi chú cho đoạn đã chọn:')??'';if(!note)return}const id='h'+Date.now()+Math.random().toString(36).slice(2,7),start=textOffset(savedRoot,savedRange.startContainer,savedRange.startOffset),end=textOffset(savedRoot,savedRange.endContainer,savedRange.endOffset);try{makeMark(savedRange,id,note);const d=annData();d.items.push({id,rootId:savedRoot.id,start,end,note});saveAnnData(d)}catch(e){alert('Hãy chọn một đoạn chữ liên tục, không bao gồm ô trả lời.')}window.getSelection()?.removeAllRanges();savedRange=null;savedRoot=null;hideTools()}
function unwrapMark(mark){const p=mark.parentNode;while(mark.firstChild)p.insertBefore(mark.firstChild,mark);p.removeChild(mark);p.normalize()}
function removeHighlight(mark){const id=mark.dataset.hid,d=annData();d.items=d.items.filter(x=>x.id!==id);saveAnnData(d);unwrapMark(mark);hideTools()}
function toggleMarkNote(mark){const d=annData(),item=d.items.find(x=>x.id===mark.dataset.hid);if(mark.dataset.note){delete mark.dataset.note;mark.removeAttribute('title');mark.classList.remove('has-note');if(item)item.note=''}else{const note=prompt('Nhập ghi chú cho đoạn highlight:');if(!note)return;mark.dataset.note=note;mark.title=note;mark.classList.add('has-note');if(item)item.note=note}saveAnnData(d);setToolLabelsForMark(mark)}
function openToolsForMark(mark){activeMark=mark;savedRange=null;savedRoot=null;setToolLabelsForMark(mark);positionTools(mark.getBoundingClientRect())}

function playEvidence(start,end){
  if(!submitted)return;
  stopAt=null;audio.pause();
  const reviewStart=Math.max(0,start-2),reviewEnd=Math.min(audio.duration||99999,end+2);
  audio.playbackRate=1;audio.currentTime=reviewStart;stopAt=reviewEnd;
  audioCard.classList.remove('finished');audioCard.classList.add('reviewing');
  audioStatusText.textContent='Đang nghe lại đoạn chứa đáp án · '+fmt(reviewStart)+'–'+fmt(reviewEnd);
  audioNow.textContent=fmt(reviewStart);
  const p=audio.play();if(p&&p.catch)p.catch(()=>audioStatusText.textContent='Không phát được đoạn review — hãy bấm lại nút Nghe đoạn chứa đáp án');
  audioCard.scrollIntoView({behavior:'smooth',block:'start'});
}
audio.addEventListener('loadedmetadata',()=>audioTotal.textContent=fmt(audio.duration||0));
audio.addEventListener('timeupdate',()=>{
  if(!submitted){lastSafeTime=audio.currentTime;audioNow.textContent=fmt(audio.currentTime);if(Number.isFinite(audio.duration)&&audio.duration>0)audioProgress.style.width=Math.min(100,(audio.currentTime/audio.duration)*100)+'%'}
  if(stopAt!==null&&audio.currentTime>=stopAt){audio.pause();stopAt=null;if(submitted){audioCard.classList.remove('reviewing');audioStatusText.textContent='Đã phát xong đoạn chứa đáp án'}}
});
audio.addEventListener('seeking',()=>{if(started&&!submitted&&!seekLock&&Math.abs(audio.currentTime-lastSafeTime)>1.25){seekLock=true;audio.currentTime=lastSafeTime;setTimeout(()=>seekLock=false,0)}});
audio.addEventListener('ratechange',()=>{if(started&&!submitted&&audio.playbackRate!==1)audio.playbackRate=1});
audio.addEventListener('pause',()=>{if(started&&!submitted&&!audio.ended&&stopAt===null)setTimeout(()=>audio.play().catch(()=>{}),50)});
audio.addEventListener('ended',()=>{audioCard.classList.remove('playing');audioCard.classList.add('finished');audioStatusText.textContent='Audio đã kết thúc · bài đang được nộp';audioProgress.style.width='100%';if(started&&!submitted)submit(true)});

function addReview(box,selected,correct,item){const d=document.createElement('div');d.className='review';d.innerHTML=`<div>Đáp án em chọn: <b class="badans">${selected||'Chưa trả lời'}</b></div><div>Đáp án đúng: <b class="goodans">${correct}</b></div><div class="why"><b>Giải thích:</b> ${item.why}</div><div class="review-actions"><button class="ev">▶ Nghe đoạn chứa đáp án (${fmt(item.start)})</button><button class="trbtn">↗ Xem transcript</button></div><div class="transcript"><div class="timecode">${fmt(item.start)}–${fmt(item.end)}</div>${item.tr}</div>`;d.querySelector('.ev').onclick=()=>playEvidence(item.start,item.end);d.querySelector('.trbtn').onclick=()=>d.querySelector('.transcript').classList.toggle('show');box.appendChild(d)}
function submit(auto=false){if(submitted)return;submitted=true;stopAt=null;audio.pause();audioCard.classList.remove('playing');audioStatusText.textContent=auto?'Audio đã kết thúc':'Bài đã nộp · có thể nghe lại đoạn chứa đáp án';let score=0,details=[];for(let n=1;n<=40;n++){const q=Q[n],a=getA(n),good=ok(q,a),box=document.getElementById('q'+n);if(good)score++;box?.classList.add(good?'good':'bad');if(!good&&box)addReview(box,a,q.display||q.a,q);details.push({question:n,answer:a,correct:q.display||q.a,isCorrect:good})}document.querySelectorAll('input,select').forEach(e=>e.disabled=true);const pct=Math.round(score/40*100),dur=Math.floor((Date.now()-started)/1000);scoreBig.textContent=score+'/40';scoreTitle.textContent=pct+'%';scoreDetail.textContent=auto?'Audio đã kết thúc — hệ thống tự động nộp bài.':(pct>=85?'Rất tốt!':pct>=70?'Khá tốt. Hãy nghe lại các đoạn chứa đáp án ở câu sai.':'Hãy dùng nút Nghe đoạn chứa đáp án và transcript để review.');result.classList.add('show');submitBtn.disabled=true;localStorage.removeItem(STORE);send(score,pct,dur,details)}
async function send(score,pct,dur,details){const p=new URLSearchParams({name:student.name,className:student.className,score:String(score),total:'40',percent:String(pct),duration:String(dur),details:JSON.stringify({testId:TEST_ID,title:'Listening Test 07',answers:details})});try{await fetch(ENDPOINT,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:p.toString()});sendStatus.textContent='đã gửi';sendStatus.className='status ok'}catch(e){sendStatus.textContent='chưa gửi được';sendStatus.className='status err'}}
function start(){const n=studentName.value.trim(),c=studentClass.value.trim();if(!n||!c){startErr.style.display='block';return}student={name:n,className:c};localStorage.setItem(STUDENT_KEY,JSON.stringify(student));localStorage.setItem('IELTS_STUDENT_NAME',n);localStorage.setItem('IELTS_STUDENT_CLASS',c);studentChip.textContent=n+' · '+c;audio.currentTime=0;audio.playbackRate=1;lastSafeTime=0;started=Date.now();restore();const p=audio.play();if(p&&p.catch)p.catch(()=>{audioStatusText.textContent='Không thể tự phát — bấm Bắt đầu làm bài lại';started=0});overlay.style.display='none';audioCard.classList.add('playing');audioStatusText.textContent='Audio đang phát · không thể tua'}

document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.pane').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById('tab'+b.dataset.tab).classList.add('active')})
document.querySelectorAll('input,select').forEach(e=>{e.addEventListener('input',()=>{save();prog()});e.addEventListener('change',()=>{save();prog()})})
document.querySelectorAll('.pane').forEach(pane=>{pane.addEventListener('mouseup',()=>setTimeout(captureSelection,10));pane.addEventListener('touchend',()=>setTimeout(captureSelection,100));pane.addEventListener('click',e=>{const mark=e.target.closest('mark.study-hl');if(mark){e.stopPropagation();openToolsForMark(mark);return}if(!e.target.closest('#textTools'))textTools.classList.remove('show')})})
hlTool.onclick=()=>{if(activeMark)removeHighlight(activeMark);else addAnnotation(false)}
noteTool.onclick=()=>{if(activeMark)toggleMarkNote(activeMark);else addAnnotation(true)}
document.addEventListener('scroll',()=>textTools.classList.remove('show'),true);
startBtn.onclick=start;
studentClass.addEventListener('keydown',e=>{if(e.key==='Enter')start()});
submitBtn.onclick=()=>{if(confirm('Nộp bài Listening Test 07?'))submit(false)};
resetBtn.onclick=()=>{if(confirm('Xóa đáp án và làm lại?')){localStorage.removeItem(STORE);location.reload()}};
prefill();applySavedAnnotations();prog();
</script>
</body></html>
